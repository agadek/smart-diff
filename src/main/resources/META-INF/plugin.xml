<idea-plugin>
    <id>io.github.agadek.smartdiff</id>
    <name>SMART Diff</name>
    <vendor url="https://github.com/agadek">agadek</vendor>

    <description><![CDATA[
        Review code changes by structure in IntelliJ-based IDEs, with the native text diff always available.
        <br/><br/>
        Free for noncommercial use under the
        <a href="https://polyformproject.org/licenses/noncommercial/1.0.0">PolyForm Noncommercial License 1.0.0</a>.
        Commercial use requires a separate license from the author.
        Source code and issues: <a href="https://github.com/agadek/smart-diff">github.com/agadek/smart-diff</a>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Language providers live in optional descriptors, so the plugin also loads in IDEs without Java or Kotlin. -->
    <depends optional="true" config-file="smartdiff-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="smartdiff-kotlin.xml">org.jetbrains.kotlin</depends>

    <extensionPoints>
        <!-- Internal: only SMART Diff and its own optional descriptors register engines (technical specification Q5). -->
        <extensionPoint name="comparisonEngine"
                        interface="io.github.agadek.smartdiff.engine.registry.ComparisonEngineFactory"
                        dynamic="true"/>
    </extensionPoints>
</idea-plugin>
