<idea-plugin>
    <id>io.github.agadek.smartdiff</id>
    <name>SMART Diff</name>
    <vendor url="https://github.com/agadek">agadek</vendor>

    <description><![CDATA[
        Review code changes by structure in IntelliJ-based IDEs: a structural outline, a refactorings view, review-tree summaries and a merge outline, with the native text diff always available.
        <br/><br/>
        SMART Diff adds a structural outline beside the side-by-side diff. For Java, Kotlin (including <i>.gradle.kts</i> scripts), Scala 2 and Scala 3, Groovy and Gradle scripts, Python, Rust, Go, shell scripts, JSON and JSON5, YAML, TOML, XML and HTML, Java properties and Markdown, it lists the declarations that changed — added, removed, changed, moved, signature changed, formatting-only and rename candidates — so a reviewer sees which methods, classes and keys a change touches before reading the lines. Swift files get an outline from a bundled Tree-sitter grammar. Other languages use the IDE's structure view, and plain text or unsupported files report moved lines as <i>lines A–B → C–D</i> alongside the other changes.
        <ul>
            <li>Select a declaration or relationship to frame every endpoint on both sides of the diff; press Enter to jump to it. Mark rows as reviewed and hide them with the reviewed filter.</li>
            <li>The refactorings view, one toolbar toggle away, lists renames with their grouped usages, moves, extractions and inlinings, with confidence, evidence and its own kind filter.</li>
            <li>Local Changes, the Commit tool window, the Git log's commit details and GitHub and GitLab pull requests show each changed file's summary, such as <i>2 changed · 1 added</i>, and its declaration rows.</li>
            <li>The merge window and three-sided diffs show a structural outline grouped by side, so changes on both sides stay visible.</li>
            <li>Hide chosen change types from the outline, fade them in the SMART Diff side-by-side viewer, keep formatting-only changes apart from content changes, and switch back to the native diff with one toolbar button.</li>
            <li>Unsupported, malformed or oversized files stay in the plain native diff with the reason shown.</li>
        </ul>
        Scala, Python, Rust and Go support need their IDE plugins installed (Python, Rust and Go are bundled in PyCharm, RustRover and GoLand); the other formats use language support bundled with the IDE. Settings are under <i>Settings | Tools | SMART Diff</i>.
        <br/><br/>
        Free for noncommercial use under the
        <a href="https://polyformproject.org/licenses/noncommercial/1.0.0">PolyForm Noncommercial License 1.0.0</a>.
        Commercial use requires a separate license from the author.
        Source code and issues: <a href="https://github.com/agadek/smart-diff">github.com/agadek/smart-diff</a>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Language providers live in optional descriptors, so the plugin also loads in IDEs without Java, Kotlin,
         Scala or JSON. -->
    <depends optional="true" config-file="smartdiff-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="smartdiff-kotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="smartdiff-scala.xml">org.intellij.scala</depends>
    <depends optional="true" config-file="smartdiff-groovy.xml">org.intellij.groovy</depends>
    <depends optional="true" config-file="smartdiff-json.xml">com.intellij.modules.json</depends>
    <depends optional="true" config-file="smartdiff-yaml.xml">org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="smartdiff-properties.xml">com.intellij.properties</depends>
    <depends optional="true" config-file="smartdiff-toml.xml">org.toml.lang</depends>
    <depends optional="true" config-file="smartdiff-xml.xml">com.intellij.modules.xml</depends>
    <depends optional="true" config-file="smartdiff-markdown.xml">org.intellij.plugins.markdown</depends>
    <depends optional="true" config-file="smartdiff-python.xml">PythonCore</depends>
    <depends optional="true" config-file="smartdiff-rust.xml">com.jetbrains.rust</depends>
    <depends optional="true" config-file="smartdiff-go.xml">org.jetbrains.plugins.go</depends>
    <depends optional="true" config-file="smartdiff-shell.xml">com.jetbrains.sh</depends>
    <!-- The Changes tree summary needs the platform's VCS support. -->
    <depends optional="true" config-file="smartdiff-vcs.xml">com.intellij.modules.vcs</depends>
    <!-- Summaries in the review trees (changes-tree/07): each tree's adapter loads only with the plugin that shows it. -->
    <depends optional="true" config-file="smartdiff-vcs-log.xml">Git4Idea</depends>
    <depends optional="true" config-file="smartdiff-github.xml">org.jetbrains.plugins.github</depends>
    <depends optional="true" config-file="smartdiff-gitlab.xml">org.jetbrains.plugins.gitlab</depends>

    <extensionPoints>
        <!-- Internal: only SMART Diff and its own optional descriptors register engines (technical specification Q5). -->
        <extensionPoint name="comparisonEngine"
                        interface="io.github.agadek.smartdiff.engine.registry.ComparisonEngineFactory"
                        dynamic="true"/>
        <!-- Internal to the declaration engine: one provider per language, each in its language's optional descriptor. -->
        <extensionPoint name="declarationProvider"
                        interface="io.github.agadek.smartdiff.engine.declarations.psi.DeclarationProvider"
                        dynamic="true"/>
        <!-- Internal to the reference pass: one resolver per language, each in its language's optional descriptor. -->
        <extensionPoint name="referenceResolver"
                        interface="io.github.agadek.smartdiff.references.ReferenceResolver"
                        dynamic="true"/>
    </extensionPoints>

    <!-- The Kotlin plugin reads this from the main descriptor only; without it, K2 mode skips smartdiff-kotlin.xml.
         The Kotlin provider uses PSI only, no analysis API, so it supports both modes. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The outline attaches to the native side-by-side viewer (ADR 0005). -->
        <diff.DiffExtension implementation="io.github.agadek.smartdiff.ui.OutlineDiffExtension"/>
        <!-- Offered beside the native viewer, which stays the default: fades the changes the outline filter hides. -->
        <diff.DiffTool implementation="io.github.agadek.smartdiff.ui.FilteringDiffTool"/>
        <!-- The merge window runs no DiffExtension: this tool lets the platform's text merge tool create the viewer and
             attaches the outline beside it (ADR 0007). -->
        <diff.merge.MergeTool order="first" implementation="io.github.agadek.smartdiff.ui.merge.MergeOutlineTool"/>
        <applicationConfigurable parentId="tools"
                                 id="io.github.agadek.smartdiff.settings"
                                 displayName="SMART Diff"
                                 instance="io.github.agadek.smartdiff.ui.SmartDiffConfigurable"/>
        <!-- The UI owns the fallback setting; the engine reads it through this interface (languages/06 R1, R10). -->
        <applicationService serviceInterface="io.github.agadek.smartdiff.engine.api.StructureViewFallbackSetting"
                            serviceImplementation="io.github.agadek.smartdiff.ui.SmartDiffStructureViewFallbackSetting"/>
        <!-- The UI owns the Tree-sitter setting; the Tree-sitter engine reads it through this interface (engines/05 R1). -->
        <applicationService serviceInterface="io.github.agadek.smartdiff.engine.api.TreeSitterSetting"
                            serviceImplementation="io.github.agadek.smartdiff.ui.SmartDiffTreeSitterSetting"/>
        <!-- The line comparison is deliberately not on the comparisonEngine extension point: the outline asks for it
             through this API service, so the registry, dropdown and stored defaults never see it (engines/04). -->
        <applicationService serviceInterface="io.github.agadek.smartdiff.engine.api.LineEngineProvider"
                            serviceImplementation="io.github.agadek.smartdiff.engine.lines.LineEngine"/>
        <!-- The confidence thresholds the declaration engine classifies its relationships with, as high,medium
             (relationships/02 R15). A malformed value keeps the default (R30). -->
        <registryKey key="smartdiff.relationships.confidence"
                     defaultValue="0.82,0.7"
                     description="SMART Diff relationship confidence thresholds: high,medium. A rename at or above the high value is high confidence, at or above the medium value medium, and below it low."/>
    </extensions>

    <actions>
        <action id="SmartDiff.ToggleOutline"
                class="io.github.agadek.smartdiff.ui.ToggleOutlineAction"
                text="Structural Outline"
                description="Show or hide the SMART Diff structural outline in this diff"
                icon="AllIcons.Toolwindows.ToolWindowStructure">
            <!-- Registered first so a narrow diff toolbar keeps it visible instead of moving it into the overflow. -->
            <add-to-group group-id="Diff.ViewerToolbar" anchor="first"/>
            <add-to-group group-id="Diff.Conflicts.Additional.Actions" anchor="last"/>
            <!-- Ctrl+Alt+Shift+O is free in the platform's default and diff keymaps; Keymap lists it under SMART Diff. -->
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift O"/>
        </action>
        <!-- Expands the collapsed unchanged fragments of the declaration at the caret (outline/14). No default shortcut:
             a user can assign one in the keymap. Diff.EditorPopupMenu is the diff editors' context menu. -->
        <action id="SmartDiff.ExpandDeclaration"
                class="io.github.agadek.smartdiff.ui.ExpandDeclarationAction"
                text="Expand Declaration"
                description="Expand the collapsed unchanged fragments of the declaration at the caret">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="first"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="io.github.agadek.smartdiff">
        <comparisonEngine order="first"
                          implementation="io.github.agadek.smartdiff.engine.declarations.psi.DeclarationEngineFactory"/>
        <!-- engines/05: languages the IDE has no language support for, chosen by file name (ADR 0015). -->
        <comparisonEngine order="last"
                          implementation="io.github.agadek.smartdiff.engine.treesitter.TreeSitterEngineFactory"/>
        <declarationProvider order="last"
                             implementation="io.github.agadek.smartdiff.engine.declarations.psi.structure.StructureViewDeclarationProvider"/>
    </extensions>
</idea-plugin>
