<idea-plugin>
    <id>io.github.agadek.smartdiff</id>
    <name>SMART Diff</name>
    <vendor url="https://github.com/agadek">agadek</vendor>

    <description><![CDATA[
        Review code changes by structure in IntelliJ-based IDEs, with the native text diff always available.
        <br/><br/>
        SMART Diff adds a structural outline beside the side-by-side diff of Java, Kotlin and Scala files. It lists
        the declarations that changed, marked added, removed, changed, moved, signature changed or formatting-only, so
        a reviewer sees which methods and classes a change touches before reading the lines.
        <ul>
            <li>Select a declaration to frame it on both sides of the diff; press Enter to jump to it.</li>
            <li>Formatting-only changes are kept apart from changes in content.</li>
            <li>Hide chosen change types from the outline, and fade them in the SMART Diff side-by-side viewer.</li>
            <li>The Local Changes and Commit tree shows each file's summary, such as <i>2 changed · 1 added</i>, and its changed declarations under it.</li>
            <li>Unsupported, malformed or oversized files stay in the plain native diff, with the reason shown.</li>
            <li>A toolbar button in every diff switches back to the plain native diff.</li>
        </ul>
        Settings are under <i>Settings | Tools | SMART Diff</i>.
        <br/><br/>
        Free for noncommercial use under the
        <a href="https://polyformproject.org/licenses/noncommercial/1.0.0">PolyForm Noncommercial License 1.0.0</a>.
        Commercial use requires a separate license from the author.
        Source code and issues: <a href="https://github.com/agadek/smart-diff">github.com/agadek/smart-diff</a>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Language providers live in optional descriptors, so the plugin also loads in IDEs without Java, Kotlin or
         Scala. -->
    <depends optional="true" config-file="smartdiff-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="smartdiff-kotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="smartdiff-scala.xml">org.intellij.scala</depends>
    <!-- The Changes tree summary needs the platform's VCS support. -->
    <depends optional="true" config-file="smartdiff-vcs.xml">com.intellij.modules.vcs</depends>

    <extensionPoints>
        <!-- Internal: only SMART Diff and its own optional descriptors register engines (technical specification Q5). -->
        <extensionPoint name="comparisonEngine"
                        interface="io.github.agadek.smartdiff.engine.registry.ComparisonEngineFactory"
                        dynamic="true"/>
        <!-- Internal to the declaration engine: one provider per language, each in its language's optional descriptor. -->
        <extensionPoint name="declarationProvider"
                        interface="io.github.agadek.smartdiff.engine.declarations.psi.DeclarationProvider"
                        dynamic="true"/>
    </extensionPoints>

    <!-- The Kotlin plugin reads this from the main descriptor only; without it, K2 mode skips smartdiff-kotlin.xml.
         The Kotlin provider uses PSI only, no analysis API, so it supports both modes. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The outline attaches to the native side-by-side viewer (ADR 0005). -->
        <diff.DiffExtension implementation="io.github.agadek.smartdiff.ui.OutlineDiffExtension"/>
        <!-- Offered beside the native viewer, which stays the default: fades the changes the outline filter hides. -->
        <diff.DiffTool implementation="io.github.agadek.smartdiff.ui.FilteringDiffTool"/>
        <!-- The merge window runs no DiffExtension: this tool lets the platform's text merge tool create the viewer and
             attaches beside it (ADR 0007). It accepts nothing while the preview registry key below is off. -->
        <diff.merge.MergeTool order="first" implementation="io.github.agadek.smartdiff.ui.merge.MergeOutlineTool"/>
        <!-- Spike S6: a placeholder for the three-way merge outline in three-sided diffs and the merge window. -->
        <registryKey key="smartdiff.merge.outline.preview" defaultValue="false"
                     description="Show the SMART Diff three-way merge outline placeholder (preview, spike S6)"/>
        <applicationConfigurable parentId="tools"
                                 id="io.github.agadek.smartdiff.settings"
                                 displayName="SMART Diff"
                                 instance="io.github.agadek.smartdiff.ui.SmartDiffConfigurable"/>
    </extensions>

    <actions>
        <action id="SmartDiff.ToggleOutline"
                class="io.github.agadek.smartdiff.ui.ToggleOutlineAction"
                text="Structural Outline"
                description="Show or hide the SMART Diff structural outline in this diff"
                icon="AllIcons.Toolwindows.ToolWindowStructure">
            <add-to-group group-id="Diff.ViewerToolbar" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="io.github.agadek.smartdiff">
        <comparisonEngine order="first"
                          implementation="io.github.agadek.smartdiff.engine.declarations.psi.DeclarationEngineFactory"/>
    </extensions>
</idea-plugin>
