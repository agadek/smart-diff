<idea-plugin>
    <extensions defaultExtensionNs="io.github.agadek.smartdiff">
        <declarationProvider implementation="io.github.agadek.smartdiff.engine.declarations.psi.groovy.GroovyDeclarationProvider"/>
    </extensions>
</idea-plugin>
