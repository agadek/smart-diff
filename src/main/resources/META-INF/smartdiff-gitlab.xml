<!-- Loaded when the GitLab plugin is installed. Adds summaries to the changes of a merge request (changes-tree/07, ADR 0013). -->
<idea-plugin>
    <extensions defaultExtensionNs="io.github.agadek.smartdiff">
        <reviewTreeAdapter implementation="io.github.agadek.smartdiff.ui.changes.GitLabTreeAdapter"/>
    </extensions>
</idea-plugin>
