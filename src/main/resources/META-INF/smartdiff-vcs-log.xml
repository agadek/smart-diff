<!-- Loaded when Git is installed. Adds summaries to the Git log's commit details tree (changes-tree/07, ADR 0013). -->
<idea-plugin>
    <extensions defaultExtensionNs="io.github.agadek.smartdiff">
        <reviewTreeAdapter implementation="io.github.agadek.smartdiff.ui.changes.GitLogTreeAdapter"/>
    </extensions>
</idea-plugin>
