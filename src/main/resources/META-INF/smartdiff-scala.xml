<!-- Loaded when the Scala plugin is present. The Scala declaration provider registers here. -->
<idea-plugin>
    <extensions defaultExtensionNs="io.github.agadek.smartdiff">
        <declarationProvider implementation="io.github.agadek.smartdiff.engine.declarations.psi.scala.ScalaDeclarationProvider"/>
        <referenceResolver implementation="io.github.agadek.smartdiff.references.ScalaReferenceResolver"/>
    </extensions>
</idea-plugin>
